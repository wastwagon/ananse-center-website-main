generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MediaAsset {
  id           String    @id @default(cuid())
  filename     String
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  width        Int?
  height       Int?
  altText      String    @default("") @map("alt_text")
  title        String    @default("")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  eventCovers  Event[]   @relation("EventCover")
  programCovers Program[] @relation("ProgramCover")
  newsCovers   NewsPost[] @relation("NewsCover")
  personPhotos Person[]  @relation("PersonPhoto")
  personLogos  Person[]  @relation("PersonLogo")
  libraryCovers LibraryItem[] @relation("LibraryCover")
  libraryAudio LibraryItem[]  @relation("LibraryAudio")
  libraryVideo LibraryItem[]  @relation("LibraryVideo")
  albumCovers  PhotoAlbum[]   @relation("AlbumCover")
  albumImages  PhotoAlbumImage[]

  @@index([mimeType, createdAt(sort: Desc)])
  @@map("media_assets")
}

model Program {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  String      @db.Text
  category     String
  section      String      @default("catalog")
  duration     String      @default("")
  level        String      @default("")
  iconKey      String      @default("BookOpen") @map("icon_key")
  features     Json        @default("[]")
  sortOrder    Int         @default(0) @map("sort_order")
  published    Boolean     @default(true)
  coverMediaId String?     @map("cover_media_id")
  coverMedia   MediaAsset? @relation("ProgramCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  events       Event[]
  libraryItems LibraryItem[]
  photoAlbums  PhotoAlbum[]
  people       PersonProgram[]
  insights     NewsPost[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([section, published, sortOrder])
  @@map("programs")
}

model Event {
  id                 String      @id @default(cuid())
  title              String
  slug               String      @unique
  description        String      @db.Text
  dateLabel          String      @map("date_label")
  startsAt           DateTime?   @map("starts_at")
  endsAt             DateTime?   @map("ends_at")
  timeLabel          String      @default("") @map("time_label")
  capacity           Int?
  registrationStatus String      @default("auto") @map("registration_status")
  /** scheduled | postponed | cancelled */
  eventStatus        String      @default("scheduled") @map("event_status")
  /** in_person | online | hybrid */
  deliveryMode       String      @default("in_person") @map("delivery_mode")
  meetingUrl         String      @default("") @map("meeting_url")
  recordingUrl       String      @default("") @map("recording_url")
  /** Separate audio when the recording link is video. */
  audioUrl           String      @default("") @map("audio_url")
  transcript         String      @default("") @db.Text
  subtitle           String      @default("")
  /** JSON string[] of media asset ids kept on the same page after the date */
  galleryMediaIds    Json        @default("[]") @map("gallery_media_ids")
  location           String
  venue              String      @default("")
  type               String
  programId          String?     @map("program_id")
  program            Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  imageEmoji         String      @default("📅") @map("image_emoji")
  coverMediaId       String?     @map("cover_media_id")
  coverMedia         MediaAsset? @relation("EventCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  storyTitle         String?     @map("story_title")
  storyBody          String?     @map("story_body") @db.Text
  highlights         Json        @default("[]")
  featured           Boolean     @default(false)
  published          Boolean     @default(true)
  photoAlbums        PhotoAlbum[]
  speakers           EventSpeaker[]
  libraryItems       LibraryItem[]
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([published, startsAt])
  @@index([programId])
  @@map("events")
}

/** Community profiles — no personal phone or email on the public record. */
model Person {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  roleTitle        String      @default("") @map("role_title")
  bio              String      @default("") @db.Text
  /** JSON string[] from Leadership | Mentors | Speakers & Faculty | Fellows and Participants | Partners */
  groups           Json        @default("[]")
  isOrganization   Boolean     @default(false) @map("is_organization")
  organizationName String      @default("") @map("organization_name")
  websiteUrl       String      @default("") @map("website_url")
  photoMediaId     String?     @map("photo_media_id")
  photoMedia       MediaAsset? @relation("PersonPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  logoMediaId      String?     @map("logo_media_id")
  logoMedia        MediaAsset? @relation("PersonLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  /** Areas of expertise, one line or a short list. */
  expertise        String      @default("") @db.Text
  /** Cohort or year for fellows and participants. */
  cohortLabel      String      @default("") @map("cohort_label")
  featured         Boolean     @default(false)
  published        Boolean     @default(false)
  sortOrder        Int         @default(0) @map("sort_order")
  libraryItems     LibraryItem[]
  programs         PersonProgram[]
  eventRoles       EventSpeaker[]
  insights         NewsPost[]
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([published, sortOrder])
  @@index([featured, published])
  @@map("people")
}

/**
 * Library shelves are views — Listen, Watch, Read.
 * Photo Gallery uses PhotoAlbum. One item may hold audio + video + transcript.
 */
model LibraryItem {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  description     String      @default("") @db.Text
  /** listen | watch | read */
  shelf           String
  /** Collection name within the shelf (e.g. Midday Reflection, Articles) */
  collection      String
  body            String      @default("") @db.Text
  transcript      String      @default("") @db.Text
  furtherStudy    String      @default("") @map("further_study") @db.Text
  wisdomNugget    String      @default("") @map("wisdom_nugget") @db.Text
  scriptureTheme  String      @default("") @map("scripture_theme")
  episodeNumber   Int?        @map("episode_number")
  dateLabel       String      @default("") @map("date_label")
  publishedAt     DateTime?   @map("published_at")
  /** JSON string[] of insight topics */
  topics          Json        @default("[]")
  keywords        String      @default("")
  programId       String?     @map("program_id")
  program         Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  eventId         String?     @map("event_id")
  event           Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  personId        String?     @map("person_id")
  person          Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)
  newsPostId      String?     @map("news_post_id")
  newsPost        NewsPost?   @relation(fields: [newsPostId], references: [id], onDelete: SetNull)
  coverMediaId    String?     @map("cover_media_id")
  coverMedia      MediaAsset? @relation("LibraryCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  audioMediaId    String?     @map("audio_media_id")
  audioMedia      MediaAsset? @relation("LibraryAudio", fields: [audioMediaId], references: [id], onDelete: SetNull)
  videoMediaId    String?     @map("video_media_id")
  videoMedia      MediaAsset? @relation("LibraryVideo", fields: [videoMediaId], references: [id], onDelete: SetNull)
  audioUrl        String      @default("") @map("audio_url")
  videoUrl        String      @default("") @map("video_url")
  featured        Boolean     @default(false)
  published       Boolean     @default(false)
  sortOrder       Int         @default(0) @map("sort_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([shelf, published, sortOrder])
  @@index([collection, published])
  @@index([episodeNumber])
  @@index([eventId])
  @@map("library_items")
}

/** Speaker, moderator, facilitator, or panelist on an event. */
model EventSpeaker {
  eventId  String @map("event_id")
  personId String @map("person_id")
  role     String @default("Speaker")
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([eventId, personId])
  @@index([personId])
  @@map("event_speakers")
}

/** Programs a person teaches, mentors, or participates in. */
model PersonProgram {
  personId  String  @map("person_id")
  programId String  @map("program_id")
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([personId, programId])
  @@index([programId])
  @@map("person_programs")
}

model PhotoAlbum {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  String      @default("") @db.Text
  dateLabel    String      @default("") @map("date_label")
  place        String      @default("")
  /** Events | Lectures | Conferences | Mentorship | People | Community Engagement | Special Programs | Historical Archive */
  collection   String      @default("Events")
  programId    String?     @map("program_id")
  program      Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  eventId      String?     @map("event_id")
  event        Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  coverMediaId String?     @map("cover_media_id")
  coverMedia   MediaAsset? @relation("AlbumCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  featured     Boolean     @default(false)
  published    Boolean     @default(false)
  sortOrder    Int         @default(0) @map("sort_order")
  images       PhotoAlbumImage[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([collection, published, sortOrder])
  @@map("photo_albums")
}

model PhotoAlbumImage {
  id        String     @id @default(cuid())
  albumId   String     @map("album_id")
  album     PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaId   String     @map("media_id")
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption   String     @default("")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([albumId, sortOrder])
  @@map("photo_album_images")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model NewsletterSubscriber {
  id                String    @id @default(cuid())
  email             String    @unique
  status            String    @default("subscribed")
  unsubscribeToken  String    @unique @map("unsubscribe_token")
  unsubscribedAt    DateTime? @map("unsubscribed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model SiteSettings {
  id                  String   @id @default("default")
  maintenanceMode     Boolean  @default(false) @map("maintenance_mode")
  maintenanceTitle    String   @default("We'll be back soon") @map("maintenance_title")
  maintenanceMessage  String   @default("The ANANSE Center website is undergoing scheduled updates. Thank you for your patience.") @map("maintenance_message") @db.Text
  siteName            String   @default("ANANSE Center for Leadership Development") @map("site_name")
  siteShortName       String   @default("ANANSE") @map("site_short_name")
  siteTagline         String   @default("Leadership. Character. Excellence. Service.") @map("site_tagline")
  siteLocation        String   @default("Ghana") @map("site_location")
  lmsPortalUrl        String   @default("") @map("lms_portal_url")
  googleAnalyticsId   String   @default("") @map("google_analytics_id")
  legacyRedirectHost  String   @default("anansecenter.oceancyber.site") @map("legacy_redirect_host")
  contactPhone        String   @default("+233 25 712 7205") @map("contact_phone")
  contactPhoneHref    String   @default("tel:+233257127205") @map("contact_phone_href")
  contactEmail        String   @default("info@anansecenter.org") @map("contact_email")
  programsEmail       String   @default("programs@anansecenter.org") @map("programs_email")
  contactHours        String   @default("Sun–Fri 9:00–17:00") @map("contact_hours")
  contactAddress      String   @default("ANANSE Center for Leadership Development\nGhana") @map("contact_address") @db.Text
  impactStats         Json     @default("[{\"value\":\"500+\",\"label\":\"Lives Impacted\"},{\"value\":\"50+\",\"label\":\"Programs Delivered\"},{\"value\":\"15+\",\"label\":\"Communities Reached\"},{\"value\":\"6\",\"label\":\"Mission Pillars\"}]") @map("impact_stats")
  socialFacebook      String   @default("https://www.facebook.com/anansecenter") @map("social_facebook")
  socialInstagram     String   @default("https://www.instagram.com/anansecenter") @map("social_instagram")
  socialYoutube       String   @default("https://www.youtube.com/@anansecenter") @map("social_youtube")
  socialTwitter       String   @default("https://twitter.com/anansecenter") @map("social_twitter")
  socialLinkedin      String   @default("") @map("social_linkedin")
  socialWhatsapp      String   @default("") @map("social_whatsapp")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model ContentBlock {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  section     String   @default("general")
  body        String   @db.Text
  format      String   @default("plain")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("content_blocks")
}

model EventRegistration {
  id         String   @id @default(cuid())
  eventSlug  String   @default("") @map("event_slug")
  eventTitle String   @default("") @map("event_title")
  name       String
  email      String
  phone      String   @default("")
  notes      String   @default("") @db.Text
  status     String   @default("new")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("event_registrations")
}

model CommunitySubmission {
  id        String   @id @default(cuid())
  type      String   @default("story")
  name      String
  email     String
  org       String   @default("")
  title     String
  body      String   @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("community_submissions")
}

model ArchiveRecord {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  culture     String   @default("")
  era         String   @default("")
  rightsNote  String   @default("") @map("rights_note")
  tags        Json     @default("[]")
  mediaUrl    String   @default("") @map("media_url")
  published   Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("archive_records")
}

model NewsPost {
  id                String      @id @default(cuid())
  title             String
  slug              String      @unique
  subtitle          String      @default("")
  excerpt           String      @db.Text
  body              String      @default("") @db.Text
  dateLabel         String      @default("") @map("date_label")
  author            String      @default("")
  authorPersonId    String?     @map("author_person_id")
  authorPerson      Person?     @relation(fields: [authorPersonId], references: [id], onDelete: SetNull)
  programId         String?     @map("program_id")
  program           Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  /** Legacy category; Insights listing prefers contentType + topics */
  category          String      @default("Articles")
  /** Articles | Essays | Leadership Reflections | Perspectives | Conversations | Special Reflections */
  contentType       String      @default("Articles") @map("content_type")
  /** JSON string[] from the 13 insight topics */
  topics            Json        @default("[]")
  /** Also list under Library → Read when true */
  showInLibraryRead Boolean     @default(false) @map("show_in_library_read")
  featured          Boolean     @default(false)
  linkHref          String      @default("") @map("link_href")
  coverMediaId      String?     @map("cover_media_id")
  coverMedia        MediaAsset? @relation("NewsCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  libraryItems      LibraryItem[]
  published         Boolean     @default(true)
  sortOrder         Int         @default(0) @map("sort_order")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([published, sortOrder])
  @@index([featured, published])
  @@index([programId])
  @@index([authorPersonId])
  @@map("news_posts")
}

model Donation {
  id          String    @id @default(cuid())
  reference   String    @unique
  email       String
  donorName   String?   @map("donor_name")
  amount      Int
  currency    String    @default("GHS")
  label       String?
  status      String    @default("pending")
  paystackRef String?   @map("paystack_ref")
  channel     String?
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("donations")
}

/** First-party, self-hosted pageviews (no third-party analytics). */
model AnalyticsPageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String   @default("")
  sessionId String   @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId, createdAt])
  @@map("analytics_page_views")
}
