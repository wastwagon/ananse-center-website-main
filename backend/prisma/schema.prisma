generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MediaAsset {
  id           String    @id @default(cuid())
  filename     String
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  width        Int?
  height       Int?
  altText      String    @default("") @map("alt_text")
  title        String    @default("")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  eventCovers  Event[]   @relation("EventCover")
  programCovers Program[] @relation("ProgramCover")

  @@index([mimeType, createdAt(sort: Desc)])
  @@map("media_assets")
}

model Program {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  String      @db.Text
  category     String
  section      String      @default("catalog")
  duration     String      @default("")
  level        String      @default("")
  iconKey      String      @default("BookOpen") @map("icon_key")
  features     Json        @default("[]")
  sortOrder    Int         @default(0) @map("sort_order")
  published    Boolean     @default(true)
  coverMediaId String?     @map("cover_media_id")
  coverMedia   MediaAsset? @relation("ProgramCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([section, published, sortOrder])
  @@map("programs")
}

model Event {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  String      @db.Text
  dateLabel    String      @map("date_label")
  location     String
  venue        String      @default("")
  type         String
  imageEmoji   String      @default("🎭") @map("image_emoji")
  coverMediaId String?     @map("cover_media_id")
  coverMedia   MediaAsset? @relation("EventCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  storyTitle   String?     @map("story_title")
  storyBody    String?     @map("story_body") @db.Text
  highlights   Json        @default("[]")
  featured     Boolean     @default(false)
  published    Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("events")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model SiteSettings {
  id                  String   @id @default("default")
  maintenanceMode     Boolean  @default(false) @map("maintenance_mode")
  maintenanceTitle    String   @default("We'll be back soon") @map("maintenance_title")
  maintenanceMessage  String   @default("The Ananse Center website is undergoing scheduled updates. Thank you for your patience.") @map("maintenance_message") @db.Text
  siteName            String   @default("The Ananse Center for Arts and Culture") @map("site_name")
  siteShortName       String   @default("Ananse Center") @map("site_short_name")
  siteTagline         String   @default("Weaving wisdom into solutions") @map("site_tagline")
  siteLocation        String   @default("Akatakyiwa, Central Region, Ghana") @map("site_location")
  lmsPortalUrl        String   @default("") @map("lms_portal_url")
  googleAnalyticsId   String   @default("") @map("google_analytics_id")
  legacyRedirectHost  String   @default("anansecenter.oceancyber.site") @map("legacy_redirect_host")
  contactPhone        String   @default("+233 25 712 7205") @map("contact_phone")
  contactPhoneHref    String   @default("tel:+233257127205") @map("contact_phone_href")
  contactEmail        String   @default("info@anansecenter.org") @map("contact_email")
  programsEmail       String   @default("programs@anansecenter.org") @map("programs_email")
  contactHours        String   @default("Mon–Fri 9:00–17:00 · Sat 10:00–14:00") @map("contact_hours")
  contactAddress      String   @default("The Ananse Center for Arts and Culture\nAkatakyiwa, Central Region\nGhana") @map("contact_address") @db.Text
  impactStats         Json     @default("[{\"value\":\"500+\",\"label\":\"Lives Impacted\"},{\"value\":\"50+\",\"label\":\"Programs Delivered\"},{\"value\":\"15+\",\"label\":\"Communities Reached\"},{\"value\":\"6\",\"label\":\"Mission Pillars\"}]") @map("impact_stats")
  socialFacebook      String   @default("https://www.facebook.com/anansecenter") @map("social_facebook")
  socialInstagram     String   @default("https://www.instagram.com/anansecenter") @map("social_instagram")
  socialYoutube       String   @default("https://www.youtube.com/@anansecenter") @map("social_youtube")
  socialTwitter       String   @default("https://twitter.com/anansecenter") @map("social_twitter")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model ContentBlock {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  section     String   @default("general")
  body        String   @db.Text
  format      String   @default("plain")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("content_blocks")
}

model EventRegistration {
  id         String   @id @default(cuid())
  eventSlug  String   @default("") @map("event_slug")
  eventTitle String   @default("") @map("event_title")
  name       String
  email      String
  phone      String   @default("")
  notes      String   @default("") @db.Text
  status     String   @default("new")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("event_registrations")
}

model CommunitySubmission {
  id        String   @id @default(cuid())
  type      String   @default("story")
  name      String
  email     String
  title     String
  body      String   @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("community_submissions")
}

model Donation {
  id          String    @id @default(cuid())
  reference   String    @unique
  email       String
  donorName   String?   @map("donor_name")
  amount      Int
  currency    String    @default("GHS")
  label       String?
  status      String    @default("pending")
  paystackRef String?   @map("paystack_ref")
  channel     String?
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("donations")
}
