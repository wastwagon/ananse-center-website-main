FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y openssl ca-certificates curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY docker/scripts/entrypoint-dev-web.sh /usr/local/bin/entrypoint-dev-web.sh
RUN chmod +x /usr/local/bin/entrypoint-dev-web.sh

ENV NEXT_TELEMETRY_DISABLED=1

ENTRYPOINT ["/usr/local/bin/entrypoint-dev-web.sh"]
CMD ["npm", "run", "dev"]
