# Copy to .env for local Docker or host development
# cp .env.example .env
#
# ─── Production (Coolify / VPS) ─────────────────────────────────────────────
# Use docker-compose.yml. Set all values in the host UI (never commit .env).
#
# NEXT_PUBLIC_SITE_URL=https://www.yourdomain.org
# NEXT_PUBLIC_API_URL=https://api.yourdomain.org
# API_INTERNAL_URL=http://backend:4000
# CORS_ORIGIN=https://www.yourdomain.org
# PAYSTACK: use live keys (pk_live_... / sk_live_...)
# ADMIN_JWT_SECRET=<random 48+ chars>
# ADMIN_PASSWORD=<strong unique password>
# SKIP_PRISMA_SEED=true          # after first successful deploy + seed
# ADMIN_ALLOW_SYSTEM_OPS=false   # omit or false in production
# POSTGRES_PASSWORD=<strong>

# PostgreSQL
POSTGRES_USER=ananse
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ananse

# Host ports (dev compose only — production stack keeps DB/Redis internal)
POSTGRES_PORT=54325
REDIS_PORT=6385
FRONTEND_PORT=3035
BACKEND_PORT=4035

# Public URLs (browser + Next.js client)
NEXT_PUBLIC_SITE_URL=http://localhost:3035
NEXT_PUBLIC_API_URL=http://localhost:4035
# Production .org domain; middleware 301s legacy host when set
# LEGACY_SITE_HOST=anansecenter.oceancyber.site
# Integrations (also editable in Admin → Settings; env wins when set)
LEGACY_SITE_HOST=anansecenter.oceancyber.site
NEXT_PUBLIC_LEGACY_SITE_HOST=anansecenter.oceancyber.site
NEXT_PUBLIC_LMS_PORTAL_URL=https://lms.example.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-side fetch from Next.js container to API (Docker service name)
API_INTERNAL_URL=http://backend:4000

# API CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3035

# Optional: skip seed on API container boot
SKIP_PRISMA_SEED=false

# Admin CMS (seeded on first API boot when SKIP_PRISMA_SEED=false)
ADMIN_EMAIL=admin@anansecenter.org
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=Site Administrator
# superadmin | admin | editor | finance
ADMIN_ROLE=admin
# Min 32 characters — change in production
ADMIN_JWT_SECRET=dev_only_change_this_secret_min_32_chars

# Optional CRM sync (Zapier, HubSpot inbound webhook, etc.)
# CRM_WEBHOOK_URL=https://hooks.example.com/ananse
# Events: donation.success, contact.created, newsletter.subscribed

# Production hardening (Coolify)
# COOKIE_SECURE=true
# TRUST_PROXY=true
# RATE_LIMIT_MAX=60
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_FORM_MAX=8
# RATE_LIMIT_DONATION_MAX=15
# STRICT_PRODUCTION_ENV=true
# NEXT_PUBLIC_ROBOTS_NOINDEX=true

# Allow migrate/seed from admin UI in production (default: dev only)
# ADMIN_ALLOW_SYSTEM_OPS=true

# Paystack (https://dashboard.paystack.com → Settings → API Keys)
# Currency defaults to GHS (Ghana Cedis). Use test keys locally: pk_test_... / sk_test_...
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
# Optional — only GHS is used; leave unset or set to GHS
# PAYSTACK_CURRENCY=GHS
