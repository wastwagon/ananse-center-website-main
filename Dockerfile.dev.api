FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y openssl ca-certificates curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/package.json ./
RUN npm install

COPY docker/scripts/entrypoint-dev-api.sh /usr/local/bin/entrypoint-dev-api.sh
RUN chmod +x /usr/local/bin/entrypoint-dev-api.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-dev-api.sh"]
CMD ["npm", "run", "dev"]
