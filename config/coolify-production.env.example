# Copy into Coolify → Environment (production). Do not commit real secrets.
# Rebuild the web service after changing any NEXT_PUBLIC_* value.

# ─── Core URLs (HTTPS, no trailing slash) ───────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.anansecenter.org
NEXT_PUBLIC_API_URL=https://www.anansecenter.org
API_INTERNAL_URL=http://backend:4000
CORS_ORIGIN=https://www.anansecenter.org

# ─── Database (strong unique password) ───────────────────────────────────────
POSTGRES_USER=ananse
POSTGRES_PASSWORD=CHANGE_ME_32_CHAR_MINIMUM
POSTGRES_DB=ananse

# ─── Admin (first deploy only for seed; then rotate password in admin UI) ───
ADMIN_EMAIL=admin@anansecenter.org
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=Site Administrator
ADMIN_ROLE=superadmin
ADMIN_JWT_SECRET=CHANGE_ME_RANDOM_48_CHARS_MINIMUM

# ─── Production hardening (recommended) ──────────────────────────────────────
NODE_ENV=production
SKIP_PRISMA_SEED=true
ADMIN_ALLOW_SYSTEM_OPS=false
COOKIE_SECURE=true
TRUST_PROXY=true

# ─── Legacy redirect + integrations ─────────────────────────────────────────
LEGACY_SITE_HOST=anansecenter.oceancyber.site
NEXT_PUBLIC_LEGACY_SITE_HOST=anansecenter.oceancyber.site
NEXT_PUBLIC_LMS_PORTAL_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Paystack (live keys in production) ──────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME
PAYSTACK_CURRENCY=GHS

# ─── Optional ────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_FORM_MAX=8
RATE_LIMIT_DONATION_MAX=15
# STRICT_PRODUCTION_ENV=true
# NEXT_PUBLIC_ROBOTS_NOINDEX=false
# CRM_WEBHOOK_URL=https://your-crm-or-automation.example/hooks/ananse
