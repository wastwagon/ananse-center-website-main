# Staging / preview on Coolify — copy and adjust. Rebuild web after NEXT_PUBLIC_* changes.

NEXT_PUBLIC_SITE_URL=https://staging.anansecenter.org
NEXT_PUBLIC_API_URL=https://staging.anansecenter.org
API_INTERNAL_URL=http://backend:4000
CORS_ORIGIN=https://staging.anansecenter.org

POSTGRES_USER=ananse
POSTGRES_PASSWORD=CHANGE_ME_STAGING
POSTGRES_DB=ananse_staging

ADMIN_EMAIL=admin@anansecenter.org
ADMIN_PASSWORD=CHANGE_ME_STAGING_PASSWORD
ADMIN_JWT_SECRET=CHANGE_ME_STAGING_JWT_48_CHARS_MINIMUM

NODE_ENV=production
SKIP_PRISMA_SEED=false
ADMIN_ALLOW_SYSTEM_OPS=true
COOKIE_SECURE=true
TRUST_PROXY=true

# Block search indexing on non-production hosts
NEXT_PUBLIC_ROBOTS_NOINDEX=true

PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME
PAYSTACK_CURRENCY=GHS

RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_FORM_MAX=12
RATE_LIMIT_DONATION_MAX=20
